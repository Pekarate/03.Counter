 184          //Sets the integration time for the proximity sensor
 185          void setProxIntegrationTime(uint8_t timeValue)
 186          {
 187   1        if(timeValue > 8 - 1) timeValue = VCNL4040_PS_IT_8T;
 188   1        else if(timeValue > 4 - 1) timeValue = VCNL4040_PS_IT_4T;
 189   1        else if(timeValue > 3 - 1) timeValue = VCNL4040_PS_IT_3T;
 190   1        else if(timeValue > 2 - 1) timeValue = VCNL4040_PS_IT_2T;
 191   1        else timeValue = VCNL4040_PS_IT_1T;
 192   1      
 193   1        bitMask(VCNL4040_PS_CONF1, LOWER, VCNL4040_PS_IT_MASK, timeValue);
 194   1      }
