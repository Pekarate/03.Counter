 178          void LCD_INIT()
 179          {
 180   1        // P05 LCD_PW out
 181   1        // P04 LCD_SCK out
 182   1        // P03 LCD_LAT out
 183   1        // P01 LCD_DATA out
 184   1        P0M1 &= 0xC5;  // 0b11000101;
 185   1        P0M2 |= ~0xC5; // 0b00111010;
 186   1        P1M1 &= ~(1 << 2); // Clear bit 2 to set P1.2 as output mode (push-pull)
 187   1        P1M2 |= (1 << 2);  // Set bit 2 to enable push-pull output for P1.2
 188   1        LCD_PWM_ON;
 189   1        LCD_SCK_LOW;
 190   1        LCD_LAT_LOW;
 191   1        LCD_DATA_LOW;
 192   1      }
