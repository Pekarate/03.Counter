 119          void bitMask(uint8_t commandAddress, uint8_t commandHeight, uint8_t mask, uint8_t thing)
 120          {
 121   1      
 122   1        xdata UINT16 val;
 123   1        xdata uint8_t registerContents;
 124   1        VCNL_Read_register(commandAddress, &val);
 125   1        //   // Grab current register context
 126   1        //
 127   1        if (commandHeight == LOWER)
 128   1          registerContents = val & 0x0F;
 129   1        else
 130   1          registerContents = val >> 8;
 131   1      
 132   1        //   // Zero-out the portions of the register we're interested in
 133   1        registerContents &= mask;
 134   1      
 135   1        //   // Mask in new thing
 136   1        registerContents |= thing;
 137   1      
 138   1        //   // Change contents
 139   1        if (commandHeight == LOWER)
 140   1        {
 141   2          val = (val & 0xFF00) + registerContents;
 142   2        }
 143   1        else
 144   1        {
 145   2          val = (val & 0x00FF) + ((UINT16)registerContents << 8);
 146   2        }
 147   1        VCNL_Write_register(commandAddress, val);
 148   1      }
