 154          
 155          void setLEDCurrent(uint8_t currentValue)
 156          {
 157   1        if(currentValue > 200 - 1) currentValue = VCNL4040_LED_200MA;
 158   1        else if(currentValue > 180 - 1) currentValue = VCNL4040_LED_180MA;
 159   1        else if(currentValue > 160 - 1) currentValue = VCNL4040_LED_160MA;
 160   1        else if(currentValue > 140 - 1) currentValue = VCNL4040_LED_140MA;
 161   1        else if(currentValue > 120 - 1) currentValue = VCNL4040_LED_120MA;
 162   1        else if(currentValue > 100 - 1) currentValue = VCNL4040_LED_100MA;
 163   1        else if(currentValue > 75 - 1) currentValue = VCNL4040_LED_75MA;
 164   1        else currentValue = VCNL4040_LED_50MA;
 165   1      
 166   1        bitMask(VCNL4040_PS_MS, UPPER, VCNL4040_LED_I_MASK, currentValue);
 167   1      }
 168          
 169          
 170          //Set the duty cycle of the IR LED. The higher the duty
 171          //ratio, the faster the response time achieved with higher power
 172          //consumption. For example, PS_Duty = 1/320, peak IRED current = 100 mA,
 173          //averaged current consumption is 100 mA/320 = 0.3125 mA.
 174          void setIRDutyCycle(uint16_t dutyValue)
 175          {
 176   1        if(dutyValue > 320 - 1) dutyValue = VCNL4040_PS_DUTY_320;
 177   1        else if(dutyValue > 160 - 1) dutyValue = VCNL4040_PS_DUTY_160;
C51 COMPILER V9.60.7.0   VCNL4040                                                          09/21/2024 12:54:56 PAGE 4   

 178   1        else if(dutyValue > 80 - 1) dutyValue = VCNL4040_PS_DUTY_80;
 179   1        else dutyValue = VCNL4040_PS_DUTY_40;
 180   1        
 181   1        bitMask(VCNL4040_PS_CONF1, LOWER, VCNL4040_PS_DUTY_MASK, dutyValue);
 182   1      }
