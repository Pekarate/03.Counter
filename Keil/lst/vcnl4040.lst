 120          void bitMask(uint8_t commandAddress, uint8_t commandHeight, uint8_t mask, uint8_t thing)
 121          {
 122   1      
 123   1        UINT16 val;
 124   1        uint8_t registerContents;
 125   1        VCNL_Read_register(commandAddress, &val);
 126   1        //   // Grab current register context
 127   1        //
 128   1        if (commandHeight == LOWER)
 129   1          registerContents = val & 0x0F;
 130   1        else
 131   1          registerContents = val >> 8;
 132   1      
 133   1        //   // Zero-out the portions of the register we're interested in
 134   1        registerContents &= mask;
 135   1      
 136   1        //   // Mask in new thing
 137   1        registerContents |= thing;
 138   1      
 139   1        //   // Change contents
 140   1        if (commandHeight == LOWER)
 141   1        {
 142   2          val = (val & 0xFF00) + registerContents;
 143   2        }
 144   1        else
 145   1        {
 146   2          val = (val & 0x00FF) + ((UINT16)registerContents << 8);
 147   2        }
 148   1        VCNL_Write_register(commandAddress, val);
 149   1      }
 150          
 151          void setLEDCurrent(uint8_t currentValue)
 152          {
 153   1        if (currentValue > 200 - 1)
 154   1          currentValue = VCNL4040_LED_200MA;
 155   1        else if (currentValue > 180 - 1)
 156   1          currentValue = VCNL4040_LED_180MA;
 157   1        else if (currentValue > 160 - 1)
 158   1          currentValue = VCNL4040_LED_160MA;
 159   1        else if (currentValue > 140 - 1)
 160   1          currentValue = VCNL4040_LED_140MA;
 161   1        else if (currentValue > 120 - 1)
 162   1          currentValue = VCNL4040_LED_120MA;
 163   1        else if (currentValue > 100 - 1)
 164   1          currentValue = VCNL4040_LED_100MA;
 165   1        else if (currentValue > 75 - 1)
 166   1          currentValue = VCNL4040_LED_75MA;
 167   1        else
 168   1          currentValue = VCNL4040_LED_50MA;
 169   1      
 170   1        bitMask(VCNL4040_PS_MS, UPPER, VCNL4040_LED_I_MASK, currentValue);
 171   1      }
 172          
 173          // Set the duty cycle of the IR LED. The higher the duty
 174          // ratio, the faster the response time achieved with higher power
 175          // consumption. For example, PS_Duty = 1/320, peak IRED current = 100 mA,
 176          // averaged current consumption is 100 mA/320 = 0.3125 mA.
 177          void setIRDutyCycle(uint16_t dutyValue)
C51 COMPILER V9.60.7.0   VCNL4040                                                          03/03/2025 23:13:59 PAGE 4   

 178          {
 179   1        if (dutyValue > 320 - 1)
 180   1          dutyValue = VCNL4040_PS_DUTY_320;
 181   1        else if (dutyValue > 160 - 1)
 182   1          dutyValue = VCNL4040_PS_DUTY_160;
 183   1        else if (dutyValue > 80 - 1)
 184   1          dutyValue = VCNL4040_PS_DUTY_80;
 185   1        else
 186   1          dutyValue = VCNL4040_PS_DUTY_40;
 187   1      
 188   1        bitMask(VCNL4040_PS_CONF1, LOWER, VCNL4040_PS_DUTY_MASK, dutyValue);
 189   1      }
