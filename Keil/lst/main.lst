 175          void LCD_INIT()
 176          {
 177   1        // P05 LCD_PW out
 178   1        // P04 LCD_SCK out
 179   1        // P03 LCD_LAT out
 180   1        // P01 LCD_DATA out
 181   1        P0M1 &= 0xC5;  // 0b11000101;
 182   1        P0M2 |= ~0xC5; // 0b00111010;
 183   1        P1M1 &= ~(1 << 2); // Clear bit 2 to set P1.2 as output mode (push-pull)
 184   1        P1M2 |= (1 << 2);  // Set bit 2 to enable push-pull output for P1.2
 185   1        LCD_PWM_ON;
 186   1        LCD_SCK_LOW;
 187   1        LCD_LAT_LOW;
 188   1        LCD_DATA_LOW;
 189   1      }
