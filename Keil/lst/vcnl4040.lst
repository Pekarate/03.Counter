 126          
 127          void bitMask(uint8_t commandAddress, uint8_t commandHeight, uint8_t mask, uint8_t thing)
 128          {
 129   1      
 130   1          UINT16 val;
 131   1          uint8_t registerContents;
 132   1          VCNL_Read_register(commandAddress,&val);
 133   1      //   // Grab current register context
 134   1      //   
 135   1          if (commandHeight == LOWER) registerContents = val & 0x0F;
 136   1          else registerContents = val >>8;
 137   1      
 138   1      //   // Zero-out the portions of the register we're interested in
 139   1          registerContents &= mask;
 140   1      
 141   1      //   // Mask in new thing
 142   1         registerContents |= thing;
 143   1      
 144   1      //   // Change contents
 145   1          if (commandHeight == LOWER)  {
 146   2              val = (val & 0xFF00) + registerContents;
 147   2          }
 148   1          else {
 149   2              val = (val & 0x00FF) + ((UINT16)registerContents<< 8);
 150   2          }
 151   1          VCNL_Write_register(commandAddress,val);
 152   1      }
