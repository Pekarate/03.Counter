 150          void setLEDCurrent(uint8_t currentValue)
 151          {
 152   1        if (currentValue > 200 - 1)
 153   1          currentValue = VCNL4040_LED_200MA;
 154   1        else if (currentValue > 180 - 1)
 155   1          currentValue = VCNL4040_LED_180MA;
 156   1        else if (currentValue > 160 - 1)
 157   1          currentValue = VCNL4040_LED_160MA;
 158   1        else if (currentValue > 140 - 1)
 159   1          currentValue = VCNL4040_LED_140MA;
 160   1        else if (currentValue > 120 - 1)
 161   1          currentValue = VCNL4040_LED_120MA;
 162   1        else if (currentValue > 100 - 1)
 163   1          currentValue = VCNL4040_LED_100MA;
 164   1        else if (currentValue > 75 - 1)
 165   1          currentValue = VCNL4040_LED_75MA;
 166   1        else
 167   1          currentValue = VCNL4040_LED_50MA;
 168   1      
 169   1        bitMask(VCNL4040_PS_MS, UPPER, VCNL4040_LED_I_MASK, currentValue);
 170   1      }
 171          
 172          // Set the duty cycle of the IR LED. The higher the duty
 173          // ratio, the faster the response time achieved with higher power
 174          // consumption. For example, PS_Duty = 1/320, peak IRED current = 100 mA,
 175          // averaged current consumption is 100 mA/320 = 0.3125 mA.
 176          void setIRDutyCycle(uint16_t dutyValue)
 177          {
C51 COMPILER V9.60.7.0   VCNL4040                                                          03/02/2025 00:13:40 PAGE 4   

 178   1        if (dutyValue > 320 - 1)
 179   1          dutyValue = VCNL4040_PS_DUTY_320;
 180   1        else if (dutyValue > 160 - 1)
 181   1          dutyValue = VCNL4040_PS_DUTY_160;
 182   1        else if (dutyValue > 80 - 1)
 183   1          dutyValue = VCNL4040_PS_DUTY_80;
 184   1        else
 185   1          dutyValue = VCNL4040_PS_DUTY_40;
 186   1      
 187   1        bitMask(VCNL4040_PS_CONF1, LOWER, VCNL4040_PS_DUTY_MASK, dutyValue);
 188   1      }
